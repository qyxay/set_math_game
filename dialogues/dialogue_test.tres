script = ExtResource("1_8cwcq")
character_name = "Alice"
content = "  \\p100\\嘿，Bob！我刚从阁楼上翻出来一个有趣东西。看起来是一个卡牌游戏。虽然旧，不过看起来很好玩的样子！有兴趣来玩吗？\\p600\\"
